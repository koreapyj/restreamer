{
  "name": "restreamer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "dev": "tsx watch src/main.ts",
    "dev:switcher": "tsx watch src/switcher/main.ts",
    "start": "node dist/main.js",
    "start:switcher": "node dist/switcher/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.13",
    "fastify": "^5.2.0",
    "undici": "^7.3.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@9.15.1",
  "license": "AGPL-3.0-or-later"
}
