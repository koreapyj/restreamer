#
# postrm: reload systemd after the unit file is gone; on purge, drop the
# persisted desired-state under /var/lib/restreamer. serveDir (HLS output,
# e.g. /media) is admin-owned viewer content and is NEVER touched here.
set -e

case "$1" in
  remove|purge)
    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload || true
    fi
    ;;
esac

if [ "$1" = "purge" ]; then
  rm -rf /var/lib/restreamer
  # enablement symlink left behind by a manual 'systemctl enable'
  rm -f /etc/systemd/system/multi-user.target.wants/restreamer.service
  # dpkg removes the conffile itself on purge; clear the dir if now empty
  rmdir --ignore-fail-on-non-empty /etc/restreamer 2>/dev/null || true
  # The 'restreamer' system user is intentionally kept (Debian convention:
  # files elsewhere, e.g. under serveDir, may still be owned by it).
fi

exit 0
