#
# postinst: create the 'restreamer' system user, own the state dir, reload
# systemd, and restart the service on upgrades if it was running. The
# service is deliberately NOT enabled/started on fresh install: the admin
# must first review /etc/restreamer/config.yaml and serveDir permissions.
set -e

case "$1" in
  configure)
    if ! getent passwd restreamer >/dev/null; then
      adduser --quiet --system --group \
        --home /var/lib/restreamer --no-create-home restreamer
    fi

    # QSV/OpenCL hardware encoding opens /dev/dri/renderD* (group 'render';
    # some driver stacks gate VA-API paths behind 'video'). Without these the
    # ffmpeg pipeline dies at device creation (AVERROR_EXTERNAL).
    for grp in render video; do
      if getent group "$grp" >/dev/null && \
         ! id -nG restreamer | tr ' ' '\n' | grep -qx "$grp"; then
        adduser --quiet restreamer "$grp"
      fi
    done

    # stateFile default is /var/lib/restreamer/desired.json
    mkdir -p /var/lib/restreamer
    chown restreamer:restreamer /var/lib/restreamer
    chmod 0750 /var/lib/restreamer

    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload || true
      # $2 = previously configured version, i.e. this is an upgrade: restart
      # the daemon if it was running so it picks up the new code.
      if [ -n "$2" ] && systemctl is-active --quiet restreamer.service; then
        systemctl restart restreamer.service || true
      fi
    fi

    if [ -z "$2" ]; then
      cat <<'EOF'
restreamer: fresh install
  1. edit /etc/restreamer/config.yaml (a commented default was installed;
     it is a conffile - your edits survive upgrades)
  2. serveDir (default /media) must exist and be writable by the
     'restreamer' user: grant permissions, or override User=/Group= via
     'systemctl edit restreamer' (read the SECURITY note in the unit first)
  3. systemctl enable --now restreamer
EOF
    fi
    ;;
esac

exit 0
